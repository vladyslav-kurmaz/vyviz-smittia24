# Середовище: development | preview | production
NEXT_PUBLIC_APP_ENV=development

# Публічний URL сайту (обовʼязково на проді — для sitemap, canonical, schema.org)
NEXT_PUBLIC_SITE_URL=

NEXT_PUBLIC_SITE_NAME="Вивіз Сміття 24"

# Telegram-бот для заявок з форми (токен від @BotFather, chat_id каналу/групи)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

NEXT_PUBLIC_MAP_EMBED_URL=

# Google Ads. ID тега (AW-…) за замовчуванням зашитий у lib/ads.ts; порожнє
# значення тут повністю вимикає тег. Мітки — з Google Ads: Цілі → Конверсії →
# дія → Тег → Фрагмент події, частина після "/" у send_to: 'AW-…/МІТКА'.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_ADS_LABEL_LEAD=
NEXT_PUBLIC_ADS_LABEL_PHONE=
NEXT_PUBLIC_ADS_LABEL_MESSENGER=
